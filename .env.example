# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored, so it's safe to put real secrets there.

# Required for the /contact form to actually send email (via Resend).
# Without this, the form still works but returns a clear "not configured"
# error instead of failing silently — see app/api/contact/route.ts.
RESEND_API_KEY=

# The production domain, no trailing slash (e.g. https://vorexa.co.za).
# Used for sitemap.xml, robots.txt, structured data and metadataBase (which
# resolves absolute Open Graph/Twitter image URLs). Falls back to a
# placeholder if unset — see lib/site.ts. Set this in Vercel's project
# environment variables once the domain is confirmed.
SITE_URL=
