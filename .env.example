# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored, so it's safe to put real secrets there.

# Required for the /contact form to actually send email (via Resend).
# Without this, the form still works but returns a clear "not configured"
# error instead of failing silently — see app/api/contact/route.ts.
RESEND_API_KEY=
